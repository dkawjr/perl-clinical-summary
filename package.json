{
  "name": "perl-clinical-summary",
  "version": "2.48.0",
  "private": true,
  "type": "module",
  "description": "PERL clinical intelligence deployment candidate for Focused Future",
  "scripts": {
    "start": "node server.mjs",
    "preview:deployment": "node tools/start-deployment-review.mjs",

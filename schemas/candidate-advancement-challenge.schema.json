{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/candidate-advancement-challenge.schema.json",
  "title": "PERL candidate cycle-action or advancement challenge",
  "oneOf": [
    { "$ref": "#/$defs/cycleActionChallenge" },
    { "$ref": "#/$defs/candidateAdvancementChallenge" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatorNamesIncluded", "humanSignaturesIncluded", "credentialsOrSecretsIncluded", "endpointsIncluded", "sourceWorkbookBytesIncluded", "summaryProseIncluded", "findingsContentIncluded", "rawResponsesIncluded", "caseFilesIncluded", "patientIdentifiersIncluded", "patientRecordsIncluded", "phiIncluded", "perlExternalTransmissionPerformed"],
      "properties": {
        "evaluatorNamesIncluded": { "const": false },
        "humanSignaturesIncluded": { "const": false },
        "credentialsOrSecretsIncluded": { "const": false },
        "endpointsIncluded": { "const": false },
        "sourceWorkbookBytesIncluded": { "const": false },
        "summaryProseIncluded": { "const": false },
        "findingsContentIncluded": { "const": false },
        "rawResponsesIncluded": { "const": false },
        "caseFilesIncluded": { "const": false },
        "patientIdentifiersIncluded": { "const": false },
        "patientRecordsIncluded": { "const": false },
        "phiIncluded": { "const": false },
        "perlExternalTransmissionPerformed": { "const": false }
      }
    },
    "baseProperties": {
      "contractVersion": true,
      "challengeId": true,
      "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
      "room": true,
      "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
      "cycleEventHash": { "$ref": "#/$defs/hash" },
      "independentResultEventHash": { "$ref": "#/$defs/hash" },
      "candidateRetestDispositionChainHead": { "$ref": "#/$defs/hash" },
      "registryFingerprint": { "$ref": "#/$defs/hash" },
      "requiredPurposeOrder": true,
      "decisionMode": true,
      "issuedAt": { "type": "string", "format": "date-time" },
      "expiresAt": { "type": "string", "format": "date-time" },
      "contentBoundary": { "$ref": "#/$defs/boundary" }
    },
    "cycleActionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "challengeId", "nonce", "room", "cycleId", "cycleEventHash", "dispositionPackageHash", "independentResultAttestationFingerprint", "independentResultEventHash", "candidateRetestDispositionChainHead", "recommendedCycleAction", "candidateRecommendation", "cycleActionPackageHash", "registryFingerprint", "requiredPurposeOrder", "decisionMode", "issuedAt", "expiresAt", "contentBoundary"],
      "properties": {
        "contractVersion": { "const": "perl-candidate-cycle-action-challenge/1.0" },
        "challengeId": { "type": "string", "pattern": "^FF-CYCLE-ACTION-CHALLENGE-[A-F0-9-]{20,80}$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "room": { "const": "cycle-action" },
        "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
        "cycleEventHash": { "$ref": "#/$defs/hash" },
        "dispositionPackageHash": { "$ref": "#/$defs/hash" },
        "independentResultAttestationFingerprint": { "$ref": "#/$defs/hash" },
        "independentResultEventHash": { "$ref": "#/$defs/hash" },
        "candidateRetestDispositionChainHead": { "$ref": "#/$defs/hash" },
        "recommendedCycleAction": { "enum": ["close-this-refinement-cycle", "continue-refinement", "hold-study"] },
        "candidateRecommendation": { "enum": ["advance-to-separate-provider-model-decision", "retain-baseline-and-refine", "no-advancement"] },
        "cycleActionPackageHash": { "$ref": "#/$defs/hash" },
        "registryFingerprint": { "$ref": "#/$defs/hash" },
        "requiredPurposeOrder": { "type": "array", "prefixItems": [{ "const": "clinical-cycle-action" }, { "const": "evaluation-custody-confirmation" }], "items": false, "minItems": 2, "maxItems": 2 },
        "decisionMode": { "const": "act-on-exact-frozen-synthetic-cycle-no-release-authority" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "contentBoundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "candidateAdvancementChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "challengeId", "nonce", "room", "cycleId", "cycleEventHash", "independentResultEventHash", "candidateRetestDispositionChainHead", "cycleActionAttestationFingerprint", "cycleActionEventHash", "laneId", "candidateSlot", "candidateFingerprint", "providerId", "modelVersion", "promptVersion", "outputContract", "policyVersion", "policyHash", "retestProtocolFingerprint", "hostingPattern", "region", "domainEvidenceFingerprint", "modelTrialChainHead", "candidateTrialChainHead", "candidateTrialProtocolFingerprint", "candidateReturnChainHead", "candidateRetestReturnChainHead", "candidatePackageHash", "registryFingerprint", "requiredPurposeOrder", "decisionMode", "issuedAt", "expiresAt", "contentBoundary"],
      "properties": {
        "contractVersion": { "const": "perl-candidate-advancement-challenge/1.0" },
        "challengeId": { "type": "string", "pattern": "^FF-CANDIDATE-ADVANCEMENT-CHALLENGE-[A-F0-9-]{20,80}$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "room": { "const": "candidate-advancement" },
        "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
        "cycleEventHash": { "$ref": "#/$defs/hash" },
        "independentResultEventHash": { "$ref": "#/$defs/hash" },
        "candidateRetestDispositionChainHead": { "$ref": "#/$defs/hash" },
        "cycleActionAttestationFingerprint": { "$ref": "#/$defs/hash" },
        "cycleActionEventHash": { "$ref": "#/$defs/hash" },
        "laneId": { "type": "string", "pattern": "^lane-i{1,3}$" },
        "candidateSlot": { "type": "string", "pattern": "^candidate-0[1-3]$" },
        "candidateFingerprint": { "$ref": "#/$defs/hash" },
        "providerId": { "$ref": "#/$defs/safeText" },
        "modelVersion": { "$ref": "#/$defs/safeText" },
        "promptVersion": { "$ref": "#/$defs/safeText" },
        "outputContract": { "$ref": "#/$defs/safeText" },
        "policyVersion": { "$ref": "#/$defs/safeText" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "retestProtocolFingerprint": { "$ref": "#/$defs/hash" },
        "hostingPattern": { "$ref": "#/$defs/safeText" },
        "region": { "$ref": "#/$defs/safeText" },
        "domainEvidenceFingerprint": { "$ref": "#/$defs/hash" },
        "modelTrialChainHead": { "$ref": "#/$defs/hash" },
        "candidateTrialChainHead": { "$ref": "#/$defs/hash" },
        "candidateTrialProtocolFingerprint": { "$ref": "#/$defs/hash" },
        "candidateReturnChainHead": { "$ref": "#/$defs/hash" },
        "candidateRetestReturnChainHead": { "$ref": "#/$defs/hash" },
        "candidatePackageHash": { "$ref": "#/$defs/hash" },
        "registryFingerprint": { "$ref": "#/$defs/hash" },
        "requiredPurposeOrder": { "type": "array", "prefixItems": [{ "const": "clinical-suitability-advancement" }, { "const": "privacy-security-transport-fit" }, { "const": "eqpass-integration-fit" }, { "const": "product-sponsor-advancement-freeze" }], "items": false, "minItems": 4, "maxItems": 4 },
        "decisionMode": { "const": "advance-exact-candidate-to-integration-readiness-no-release-authority" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "contentBoundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "safeText": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/-]{1,159}$" }
  }
}

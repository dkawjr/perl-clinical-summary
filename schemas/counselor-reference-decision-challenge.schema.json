{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/counselor-reference-decision-challenge.schema.json",
  "title": "PERL counselor-reference decision challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "challengeId", "nonce", "dossierFingerprint", "adjudicationChainHead", "referenceDraftChainHead", "registryFingerprint", "caseSet", "caseBindings", "requiredPurposeOrder", "decisionMode", "issuedAt", "expiresAt", "contentBoundary"],
  "properties": {
    "contractVersion": { "const": "perl-counselor-reference-decision-challenge/1.0" },
    "challengeId": { "type": "string", "pattern": "^FF-REFERENCE-CHALLENGE-[A-F0-9-]{20,80}$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "dossierFingerprint": { "$ref": "#/$defs/hash" },
    "adjudicationChainHead": { "$ref": "#/$defs/hash" },
    "referenceDraftChainHead": { "$ref": "#/$defs/hash" },
    "registryFingerprint": { "$ref": "#/$defs/hash" },
    "caseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "caseBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessmentId", "sourceProfileHash", "draftHashes"],
        "properties": {
          "assessmentId": { "type": "string", "minLength": 1 },
          "sourceProfileHash": { "$ref": "#/$defs/hash" },
          "draftHashes": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } }
        }
      }
    },
    "requiredPurposeOrder": {
      "type": "array",
      "prefixItems": [
        { "const": "reference-authorship-attestation" },
        { "const": "reference-language-safety-acceptance" },
        { "const": "reference-adjudication-decision" },
        { "const": "reference-protocol-freeze" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "decisionMode": { "const": "source-only-reference-freeze-independent-review-next" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "contentBoundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceFilesIncluded", "humanNamesIncluded", "humanSignaturesIncluded", "credentialsOrSecretsIncluded", "candidateProseIncluded", "findingsContentIncluded", "rawResponseContentIncluded", "patientRecordsIncluded", "phiIncluded", "perlExternalTransmissionPerformed"],
      "properties": {
        "evidenceFilesIncluded": { "const": false },
        "humanNamesIncluded": { "const": false },
        "humanSignaturesIncluded": { "const": false },
        "credentialsOrSecretsIncluded": { "const": false },
        "candidateProseIncluded": { "const": false },
        "findingsContentIncluded": { "const": false },
        "rawResponseContentIncluded": { "const": false },
        "patientRecordsIncluded": { "const": false },
        "phiIncluded": { "const": false },
        "perlExternalTransmissionPerformed": { "const": false }
      }
    }
  }
}

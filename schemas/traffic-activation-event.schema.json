{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/traffic-activation-event.schema.json",
  "title": "PERL Clinical Traffic Activation Witness Event",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/challengeEvent" },
    { "$ref": "#/$defs/authorizationEvent" },
    { "$ref": "#/$defs/transactionEvent" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceFilesIncluded", "humanNamesIncluded", "humanSignaturesIncluded", "credentialsOrSecretsIncluded", "patientRecordContentIncluded", "directIdentifiersIncluded", "findingsContentIncluded", "phiIncluded", "endpointOrCredentialIncluded", "perlExternalTransmissionPerformed"],
      "properties": {
        "evidenceFilesIncluded": { "const": false },
        "humanNamesIncluded": { "const": false },
        "humanSignaturesIncluded": { "const": false },
        "credentialsOrSecretsIncluded": { "const": false },
        "patientRecordContentIncluded": { "const": false },
        "directIdentifiersIncluded": { "const": false },
        "findingsContentIncluded": { "const": false },
        "phiIncluded": { "const": false },
        "endpointOrCredentialIncluded": { "const": false },
        "perlExternalTransmissionPerformed": { "const": false }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^FF-TRAFFIC-KEY-[A-Z0-9-]{3,80}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "tenantRef", "releaseId", "artifactDigest", "configurationDigest"],
      "properties": {
        "environmentId": { "const": "eqpass-azure-pilot" },
        "tenantRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$" },
        "releaseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$" },
        "artifactDigest": { "$ref": "#/$defs/hash" },
        "configurationDigest": { "$ref": "#/$defs/hash" }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "sequence", "previousHash", "eventType", "contractVersion", "actor", "createdAt", "clinicalActivationConcurrenceVerified", "operationsActivationConcurrenceVerified", "externalTrafficActivationAuthorized", "firstGovernedTransactionVerified", "perlSandboxTrafficEnabled", "perlSandboxPatientRecordsProcessed", "phiStored", "boundary", "hash"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "previousHash": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "contractVersion": { "const": "perl-clinical-traffic-activation-witness/1.0" },
        "actor": { "type": "string", "minLength": 2, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "perlSandboxTrafficEnabled": { "const": false },
        "perlSandboxPatientRecordsProcessed": { "const": false },
        "phiStored": { "const": false },
        "boundary": { "type": "string", "minLength": 300 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "challengeId", "nonce", "candidateId", "dossierFingerprint", "releaseGateFingerprint", "releaseChainHead", "clinicalAuthorizationFingerprint", "productionAuthorizationFingerprint", "deploymentAttestationFingerprint", "continuityFingerprint", "registryFingerprint", "requiredPurposeOrder", "witnessMode", "issuedAt", "expiresAt", "contentBoundary"],
      "properties": {
        "contractVersion": { "const": "perl-traffic-activation-challenge/1.0" },
        "challengeId": { "type": "string", "pattern": "^FF-TRAFFIC-CHALLENGE-[A-F0-9-]{20,80}$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "candidateId": { "enum": ["north-central-counseling-center", "cooper-psych-clinic-qi"] },
        "dossierFingerprint": { "$ref": "#/$defs/hash" },
        "releaseGateFingerprint": { "$ref": "#/$defs/hash" },
        "releaseChainHead": { "$ref": "#/$defs/hash" },
        "clinicalAuthorizationFingerprint": { "$ref": "#/$defs/hash" },
        "productionAuthorizationFingerprint": { "$ref": "#/$defs/hash" },
        "deploymentAttestationFingerprint": { "$ref": "#/$defs/hash" },
        "continuityFingerprint": { "$ref": "#/$defs/hash" },
        "registryFingerprint": { "$ref": "#/$defs/hash" },
        "requiredPurposeOrder": { "const": ["clinical-traffic-activation-clinical", "clinical-traffic-activation-operations", "first-governed-transaction-attestation"] },
        "witnessMode": { "const": "external-switch-dual-control-first-transaction-witness" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "contentBoundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "challengeId", "candidateId", "registryFingerprint", "keyId", "authorizationId", "duty", "releaseGateFingerprint", "issuedAt", "expiresAt", "activationWindow", "deployment", "endpointBindings", "controlReferences", "authorityState", "contentBoundary", "signature"],
      "properties": {
        "contractVersion": { "const": "perl-traffic-activation-authorization/1.0" },
        "challengeId": { "type": "string" },
        "candidateId": { "enum": ["north-central-counseling-center", "cooper-psych-clinic-qi"] },
        "registryFingerprint": { "$ref": "#/$defs/hash" },
        "keyId": { "type": "string", "pattern": "^FF-TRAFFIC-KEY-[A-Z0-9-]{3,80}$" },
        "authorizationId": { "type": "string", "pattern": "^FF-TRAFFIC-AUTH-[A-Z0-9-]{3,80}$" },
        "duty": { "enum": ["clinical-traffic-activation-clinical", "clinical-traffic-activation-operations"] },
        "releaseGateFingerprint": { "$ref": "#/$defs/hash" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "activationWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notBefore", "notAfter"],
          "properties": { "notBefore": { "type": "string", "format": "date-time" }, "notAfter": { "type": "string", "format": "date-time" } }
        },
        "deployment": { "$ref": "#/$defs/deployment" },
        "endpointBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connectionProfileRef", "endpointIdentityFingerprint", "rolePolicyFingerprint", "tenantIsolationFingerprint"],
          "properties": {
            "connectionProfileRef": { "type": "string" },
            "endpointIdentityFingerprint": { "$ref": "#/$defs/hash" },
            "rolePolicyFingerprint": { "$ref": "#/$defs/hash" },
            "tenantIsolationFingerprint": { "$ref": "#/$defs/hash" }
          }
        },
        "controlReferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseEvidence", "clinicalStopAuthority", "monitoring", "backup", "incidentRoutes", "rollback", "identityAccess", "minimumNecessary"],
          "properties": {
            "releaseEvidence": { "$ref": "#/$defs/hash" }, "clinicalStopAuthority": { "$ref": "#/$defs/hash" },
            "monitoring": { "$ref": "#/$defs/hash" }, "backup": { "$ref": "#/$defs/hash" },
            "incidentRoutes": { "$ref": "#/$defs/hash" }, "rollback": { "$ref": "#/$defs/hash" },
            "identityAccess": { "$ref": "#/$defs/hash" }, "minimumNecessary": { "$ref": "#/$defs/hash" }
          }
        },
        "authorityState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["externalTrafficActivationAuthorized", "perlSandboxControlsTraffic", "perlSandboxReceivesPatientRecords", "autonomousClinicalDecisionAllowed"],
          "properties": {
            "externalTrafficActivationAuthorized": { "const": true },
            "perlSandboxControlsTraffic": { "const": false },
            "perlSandboxReceivesPatientRecords": { "const": false },
            "autonomousClinicalDecisionAllowed": { "const": false }
          }
        },
        "contentBoundary": { "$ref": "#/$defs/boundary" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "challengeId", "candidateId", "registryFingerprint", "keyId", "attestationId", "clinicalAuthorizationFingerprint", "operationsAuthorizationFingerprint", "activationPlanFingerprint", "observedAt", "deployment", "transactionReferences", "controlChecks", "transactionState", "contentBoundary", "signature"],
      "properties": {
        "contractVersion": { "const": "perl-first-governed-transaction-attestation/1.0" },
        "challengeId": { "type": "string" },
        "candidateId": { "enum": ["north-central-counseling-center", "cooper-psych-clinic-qi"] },
        "registryFingerprint": { "$ref": "#/$defs/hash" },
        "keyId": { "type": "string", "pattern": "^FF-TRAFFIC-KEY-[A-Z0-9-]{3,80}$" },
        "attestationId": { "type": "string", "pattern": "^FF-FIRST-TXN-ATTEST-[A-Z0-9-]{3,80}$" },
        "clinicalAuthorizationFingerprint": { "$ref": "#/$defs/hash" },
        "operationsAuthorizationFingerprint": { "$ref": "#/$defs/hash" },
        "activationPlanFingerprint": { "$ref": "#/$defs/hash" },
        "observedAt": { "type": "string", "format": "date-time" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "transactionReferences": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceEventReceipt", "findingsReport", "summaryArtifact", "remoteAcknowledgement", "auditRecord"],
          "properties": { "sourceEventReceipt": { "$ref": "#/$defs/hash" }, "findingsReport": { "$ref": "#/$defs/hash" }, "summaryArtifact": { "$ref": "#/$defs/hash" }, "remoteAcknowledgement": { "$ref": "#/$defs/hash" }, "auditRecord": { "$ref": "#/$defs/hash" } }
        },
        "controlChecks": {
          "type": "object", "additionalProperties": false,
          "required": ["authenticatedRole", "namedSiteScope", "minimumNecessary", "scoringUpstream", "findingsUnchanged", "humanReviewCompleted", "criticalRoutingVerified", "remoteAttachmentAcknowledged", "auditCommitted"],
          "properties": { "authenticatedRole": { "const": true }, "namedSiteScope": { "const": true }, "minimumNecessary": { "const": true }, "scoringUpstream": { "const": true }, "findingsUnchanged": { "const": true }, "humanReviewCompleted": { "const": true }, "criticalRoutingVerified": { "const": true }, "remoteAttachmentAcknowledged": { "const": true }, "auditCommitted": { "const": true } }
        },
        "transactionState": {
          "type": "object", "additionalProperties": false,
          "required": ["externalClinicalTrafficObserved", "firstGovernedTransactionObserved", "safetyDisposition", "perlSandboxReceivedRecord", "perlSandboxStoredPhi", "autonomousClinicalDecision"],
          "properties": { "externalClinicalTrafficObserved": { "const": true }, "firstGovernedTransactionObserved": { "const": true }, "safetyDisposition": { "enum": ["routine-review", "clinical-hold"] }, "perlSandboxReceivedRecord": { "const": false }, "perlSandboxStoredPhi": { "const": false }, "autonomousClinicalDecision": { "const": false } }
        },
        "contentBoundary": { "$ref": "#/$defs/boundary" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "challengeEvent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "additionalProperties": false, "required": ["challenge"], "properties": {
          "id": true, "sequence": true, "previousHash": true, "eventType": { "const": "traffic-activation-challenge-issued" }, "contractVersion": true,
          "challenge": { "$ref": "#/$defs/challenge" }, "actor": true, "createdAt": true,
          "clinicalActivationConcurrenceVerified": { "const": false }, "operationsActivationConcurrenceVerified": { "const": false },
          "externalTrafficActivationAuthorized": { "const": false }, "firstGovernedTransactionVerified": { "const": false },
          "perlSandboxTrafficEnabled": true, "perlSandboxPatientRecordsProcessed": true, "phiStored": true, "boundary": true, "hash": true
        } }
      ]
    },
    "authorizationEvent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "additionalProperties": false, "required": ["authorization", "authorizationFingerprint", "activationPlanFingerprint", "keyFingerprint"], "properties": {
          "id": true, "sequence": true, "previousHash": true,
          "eventType": { "enum": ["traffic-activation-clinical-authorized", "traffic-activation-operations-authorized"] }, "contractVersion": true,
          "authorization": { "$ref": "#/$defs/authorization" }, "authorizationFingerprint": { "$ref": "#/$defs/hash" }, "activationPlanFingerprint": { "$ref": "#/$defs/hash" }, "keyFingerprint": { "$ref": "#/$defs/hash" },
          "actor": true, "createdAt": true, "clinicalActivationConcurrenceVerified": { "const": true }, "operationsActivationConcurrenceVerified": { "type": "boolean" },
          "externalTrafficActivationAuthorized": { "type": "boolean" }, "firstGovernedTransactionVerified": { "const": false },
          "perlSandboxTrafficEnabled": true, "perlSandboxPatientRecordsProcessed": true, "phiStored": true, "boundary": true, "hash": true
        } }
      ]
    },
    "transactionEvent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "additionalProperties": false, "required": ["attestation", "attestationFingerprint", "keyFingerprint"], "properties": {
          "id": true, "sequence": true, "previousHash": true, "eventType": { "const": "first-governed-transaction-attested" }, "contractVersion": true,
          "attestation": { "$ref": "#/$defs/attestation" }, "attestationFingerprint": { "$ref": "#/$defs/hash" }, "keyFingerprint": { "$ref": "#/$defs/hash" },
          "actor": true, "createdAt": true, "clinicalActivationConcurrenceVerified": { "const": true }, "operationsActivationConcurrenceVerified": { "const": true },
          "externalTrafficActivationAuthorized": { "const": true }, "firstGovernedTransactionVerified": { "const": true },
          "perlSandboxTrafficEnabled": true, "perlSandboxPatientRecordsProcessed": true, "phiStored": true, "boundary": true, "hash": true
        } }
      ]
    }
  }
}

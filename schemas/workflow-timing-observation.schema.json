{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/workflow-timing-observation.schema.json",
  "title": "PERL workflow timing observation",
  "description": "One completed synthetic unaided-synthesis or PERL-assisted-review timing task. Client-supplied durations are never accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "taskId", "assessmentId", "condition", "contract", "sourceProjection",
    "caseSet", "partition", "strata", "sourceVersion", "referenceVersion",
    "sourceAssessmentHash", "actor", "reviewTiming", "finalSummary", "initialDraftHash",
    "changedTokens", "provider", "clinicalValidation", "claimBoundary", "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "taskId": { "type": "string", "format": "uuid" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "condition": { "enum": ["unaided", "perl-assisted"] },
    "contract": { "const": "perl-workflow-timing/1.0" },
    "sourceProjection": { "const": "scored-profile-v1" },
    "caseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{4,79}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "partition": { "enum": ["development", "holdout"] },
    "strata": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "sourceVersion": { "type": "string", "minLength": 3 },
    "referenceVersion": { "type": "string", "minLength": 3 },
    "sourceAssessmentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" },
    "reviewTiming": { "$ref": "#/$defs/reviewTiming" },
    "finalSummary": { "type": "string", "minLength": 80, "maxLength": 1500 },
    "initialDraftHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "changedTokens": { "type": ["integer", "null"], "minimum": 0 },
    "provider": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "mode"],
          "properties": {
            "id": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 2 },
            "mode": { "type": "string", "minLength": 2 }
          }
        }
      ]
    },
    "clinicalValidation": { "const": false },
    "claimBoundary": { "type": "string", "minLength": 80 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "reviewTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignedAt", "submittedAt", "rawSeconds", "pausedSeconds", "activeSeconds", "eligible", "flag", "measurement"],
      "properties": {
        "assignedAt": { "type": "string", "format": "date-time" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "rawSeconds": { "type": "integer", "minimum": 0 },
        "pausedSeconds": { "type": "integer", "minimum": 0 },
        "activeSeconds": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "boolean" },
        "flag": { "type": ["string", "null"], "enum": [null, "clock-anomaly", "below-protocol-floor", "above-protocol-ceiling"] },
        "measurement": { "const": "server-wall-clock-v1" }
      }
    }
  }
}

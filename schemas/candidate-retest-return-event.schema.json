{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.example/schemas/candidate-retest-return-event.schema.json",
  "title": "PERL Candidate Same-Case Retest Return Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "eventType", "status", "envelopeId", "cycleId", "cycleEventHash", "laneId", "caseId", "caseFingerprint", "baselineArtifactHash", "baselinePromptVersionHash", "retestProtocolFingerprint", "candidateFingerprint", "providerId", "modelVersion", "promptVersion", "executionReferenceHash", "intervention", "outputContract", "policyVersion", "policyHash", "bundle", "bundleHash", "outputGatePassed", "outputGateCount", "syntheticOnly", "manualExternalExecutionDeclared", "sameProviderModelDeclared", "interventionAppliedDeclared", "candidateRetestReturnReceived", "privacyBoundary", "decision", "providerCallPerformedByPerl", "modelModificationPerformedByPerl", "externalTransferPerformedByPerl", "candidateRetestExecutionVerified", "candidateRunExternallyVerified", "providerVerified", "reviewerIdentityVerified", "counselorQualificationVerified", "blindReReviewCompleted", "improvementEstablished", "accuracyEstablished", "reliabilityEstablished", "safetyEstablished", "usefulnessEstablished", "clinicalStandardMet", "clinicalValidation", "engineRanked", "engineSelected", "carePlanChanged", "pilotAuthorized", "productionReleaseAuthorized", "patientUseAuthorized", "actorCodeHash", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "contractVersion": { "const": "perl-candidate-retest-return/1.0" },
    "eventType": { "const": "manual-synthetic-candidate-retest-return-recorded" },
    "status": { "const": "structured-retest-return-held-unverified" },
    "envelopeId": { "type": "string", "pattern": "^FF-CANDIDATE-RETEST-[A-F0-9-]{20,80}$" },
    "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
    "cycleEventHash": { "$ref": "#/$defs/hash" },
    "laneId": { "enum": ["lane-i", "lane-ii", "lane-iii"] },
    "caseId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]{3,40}$" },
    "caseFingerprint": { "$ref": "#/$defs/hash" },
    "baselineArtifactHash": { "$ref": "#/$defs/hash" },
    "baselinePromptVersionHash": { "$ref": "#/$defs/hash" },
    "retestProtocolFingerprint": { "$ref": "#/$defs/hash" },
    "candidateFingerprint": { "$ref": "#/$defs/hash" },
    "providerId": { "$ref": "#/$defs/safeText" },
    "modelVersion": { "$ref": "#/$defs/safeText" },
    "promptVersion": { "$ref": "#/$defs/safeText" },
    "executionReferenceHash": { "$ref": "#/$defs/hash" },
    "intervention": { "$ref": "#/$defs/intervention" },
    "outputContract": { "const": "perl-generation-bundle/1.0" },
    "policyVersion": { "type": "string", "minLength": 4, "maxLength": 120 },
    "policyHash": { "$ref": "#/$defs/hash" },
    "bundle": { "type": "object" },
    "bundleHash": { "$ref": "#/$defs/hash" },
    "outputGatePassed": { "const": true },
    "outputGateCount": { "const": 10 },
    "syntheticOnly": { "const": true },
    "manualExternalExecutionDeclared": { "const": true },
    "sameProviderModelDeclared": { "const": true },
    "interventionAppliedDeclared": { "const": true },
    "candidateRetestReturnReceived": { "const": true },
    "privacyBoundary": { "$ref": "#/$defs/privacyBoundary" },
    "decision": { "const": "hold-structured-retest-output-for-blinded-same-case-rereview" },
    "providerCallPerformedByPerl": { "const": false },
    "modelModificationPerformedByPerl": { "const": false },
    "externalTransferPerformedByPerl": { "const": false },
    "candidateRetestExecutionVerified": { "const": false },
    "candidateRunExternallyVerified": { "const": false },
    "providerVerified": { "const": false },
    "reviewerIdentityVerified": { "const": false },
    "counselorQualificationVerified": { "const": false },
    "blindReReviewCompleted": { "const": false },
    "improvementEstablished": { "const": false },
    "accuracyEstablished": { "const": false },
    "reliabilityEstablished": { "const": false },
    "safetyEstablished": { "const": false },
    "usefulnessEstablished": { "const": false },
    "clinicalStandardMet": { "const": false },
    "clinicalValidation": { "const": false },
    "engineRanked": { "const": false },
    "engineSelected": { "const": false },
    "carePlanChanged": { "const": false },
    "pilotAuthorized": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actorCodeHash": { "$ref": "#/$defs/hash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 420, "maxLength": 1400 },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeText": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/-]{1,119}$" },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetMeasure", "iterationGoal"],
      "properties": {
        "type": { "enum": ["evidence-grounding-constraint", "diagnostic-restraint-constraint", "material-signal-coverage", "tone-and-clarity-structure", "workflow-usefulness-structure"] },
        "targetMeasure": { "enum": ["evidence-fidelity", "clinical-restraint", "conversation-usefulness"] },
        "iterationGoal": { "enum": ["reduce-repeated-correction", "preserve-fidelity-and-restraint", "reduce-material-burden", "improve-usefulness-without-overreach"] }
      }
    },
    "privacyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentPayloadIncluded", "rawResponsesIncluded", "findingsContentIncluded", "sourceFileBytesIncluded", "patientIdentifiersIncluded", "counselorIdentityIncluded", "reviewerIdentityIncluded", "credentialsIncluded", "endpointIncluded", "phiIncluded"],
      "properties": {
        "assessmentPayloadIncluded": { "const": false },
        "rawResponsesIncluded": { "const": false },
        "findingsContentIncluded": { "const": false },
        "sourceFileBytesIncluded": { "const": false },
        "patientIdentifiersIncluded": { "const": false },
        "counselorIdentityIncluded": { "const": false },
        "reviewerIdentityIncluded": { "const": false },
        "credentialsIncluded": { "const": false },
        "endpointIncluded": { "const": false },
        "phiIncluded": { "const": false }
      }
    }
  }
}

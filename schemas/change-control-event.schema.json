{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/change-control-event.schema.json",
  "title": "PERL governed change-control event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "previousHash", "type", "candidateId", "component", "candidateVersion", "actor", "clinicalReleaseAuthorized", "createdAt", "hash"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "type": { "enum": ["proposed", "replayed", "disposition"] },
    "candidateId": { "type": "string", "format": "uuid" },
    "component": { "enum": ["model", "report-template", "disclaimer", "state-schema", "release-evaluator"] },
    "candidateVersion": { "type": "string", "minLength": 2, "maxLength": 160 },
    "baselineVersion": { "type": "string", "minLength": 2, "maxLength": 120 },
    "reason": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "actor": { "type": "string", "minLength": 2, "maxLength": 48 },
    "affectedCases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^FF-TEST-" } },
    "caseSet": { "type": "object" },
    "refinementEvidence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "briefFingerprint", "generatedAt", "signalSnapshots", "sourceChainHeads", "clinicalValidation", "claimBoundary"],
          "properties": {
            "contract": { "const": "perl-refinement-brief/1.0" },
            "briefFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "generatedAt": { "type": "string", "format": "date-time" },
            "signalSnapshots": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "object" } },
            "sourceChainHeads": { "type": "object" },
            "clinicalValidation": { "const": false },
            "claimBoundary": { "type": "string", "pattern": "may not change clinical logic automatically" }
          }
        }
      ]
    },
    "evaluator": { "type": "string" },
    "engineeringRegressionPassed": { "type": "boolean" },
    "clinicalValidation": { "const": false },
    "evidence": { "$ref": "release-evidence.schema.json" },
    "disposition": { "enum": ["advance-for-clinical-review", "rollback"] },
    "note": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "clinicalReleaseAuthorized": { "const": false },
    "boundary": { "type": "string", "minLength": 20 },
    "createdAt": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "proposed" } } },
      "then": { "required": ["baselineVersion", "reason", "affectedCases", "caseSet"] }
    },
    {
      "if": { "properties": { "type": { "const": "replayed" } } },
      "then": { "required": ["evaluator", "engineeringRegressionPassed", "clinicalValidation", "evidence", "boundary"] }
    },
    {
      "if": { "properties": { "type": { "const": "disposition" } } },
      "then": { "required": ["disposition", "note", "boundary"] }
    }
  ]
}

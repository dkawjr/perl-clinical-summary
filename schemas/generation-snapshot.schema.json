{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/generation-snapshot.schema.json",
  "title": "PERL materialized generation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "assessmentId", "inputSchemaVersion", "inputHash", "outputSchemaVersion", "outputHash", "provider", "bundle", "origin", "actor", "createdAt", "note", "hash"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "inputSchemaVersion": { "const": "perl-scored-profile/1.0" },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputSchemaVersion": { "const": "perl-generation-bundle/1.0" },
    "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "mode", "promptVersion", "policyVersion", "policyHash", "inputSchemaVersion", "outputSchemaVersion", "approvedBy", "approvalScope", "phiApproved", "externalTransmission", "failureMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mode": { "enum": ["rules", "structured-candidate"] },
        "promptVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "policyVersion": { "const": "perl-clinical-generation-policy/1.0" },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "inputSchemaVersion": { "const": "perl-scored-profile/1.0" },
        "outputSchemaVersion": { "const": "perl-generation-bundle/1.0" },
        "approvedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
        "approvalScope": { "const": "synthetic-calibration-only" },
        "phiApproved": { "const": false },
        "externalTransmission": { "type": "boolean" },
        "failureMode": { "type": "string", "minLength": 10, "maxLength": 120 }
      }
    },
    "bundle": { "type": "object" },
    "origin": { "enum": ["schema-v14-migration", "seed-initialization", "fixture-import", "source-event-import", "runtime-generation"] },
    "actor": { "type": "string", "minLength": 2, "maxLength": 120 },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 20, "maxLength": 300 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/model-generation-response.schema.json",
  "title": "PERL structured generation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["narratives", "interpretation"],
  "properties": {
    "narratives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clinician", "care", "payer", "admin"],
      "properties": {
        "clinician": { "$ref": "#/$defs/narrative" },
        "care": { "$ref": "#/$defs/narrative" },
        "payer": { "$ref": "#/$defs/narrative" },
        "admin": { "$ref": "#/$defs/narrative" }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypotheses", "questions"],
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body", "confidence", "evidence"],
            "properties": {
              "title": { "type": "string", "minLength": 3, "maxLength": 180 },
              "body": { "type": "string", "minLength": 40, "maxLength": 1400 },
              "confidence": { "enum": ["Low", "Moderate", "High"] },
              "evidence": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 140 } }
            }
          }
        },
        "questions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }
      }
    }
  },
  "$defs": {
    "narrative": { "type": "string", "minLength": 40, "maxLength": 6000 }
  }
}

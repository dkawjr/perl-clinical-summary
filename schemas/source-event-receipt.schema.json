{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/source-event-receipt.schema.json",
  "title": "PERL synthetic e-QPASS source-event receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sequence",
    "previousHash",
    "type",
    "contractVersion",
    "contractStatus",
    "eventType",
    "eventIdHash",
    "idempotencyKeyHash",
    "sourceEventHash",
    "modelProjectionHash",
    "assessmentId",
    "instrumentVersion",
    "scoringVersion",
    "responseVersion",
    "findingsReportVersion",
    "findingsReportHash",
    "receivedAt",
    "actor",
    "note",
    "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "type": { "const": "synthetic-score-event-imported" },
    "contractVersion": { "const": "eqpass-perl-score-event/rfi-0.1" },
    "contractStatus": { "const": "proposed-rfi-only" },
    "eventType": { "const": "assessment.scored" },
    "eventIdHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotencyKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelProjectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "instrumentVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "scoringVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "responseVersion": { "type": ["string", "null"], "maxLength": 120 },
    "findingsReportVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "findingsReportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 2, "maxLength": 48 },
    "note": { "type": "string", "minLength": 20, "maxLength": 300 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

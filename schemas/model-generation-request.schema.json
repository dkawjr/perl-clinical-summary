{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/model-generation-request.schema.json",
  "title": "PERL structured generation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "inputSchemaVersion", "outputSchemaVersion", "policyVersion", "policyHash", "instructions", "payload"],
  "properties": {
    "contractVersion": { "const": "perl-structured-generation-request/0.1" },
    "requestId": { "type": "string", "format": "uuid" },
    "inputSchemaVersion": { "const": "perl-scored-profile/1.0" },
    "outputSchemaVersion": { "const": "perl-generation-bundle/1.0" },
    "policyVersion": { "const": "perl-clinical-generation-policy/1.0" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instructions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 20, "maxLength": 400 }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemsAnswered", "scales", "subscales", "criticalResponses"],
      "properties": {
        "itemsAnswered": { "const": 105 },
        "scales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depression", "anxiety", "anger", "gpi", "phobicAvoidance", "obsessiveCompulsive", "psychoticism", "suicideRisk", "violenceRisk"],
          "properties": {
            "depression": { "type": "integer", "minimum": 0 },
            "anxiety": { "type": "integer", "minimum": 0 },
            "anger": { "type": "integer", "minimum": 0 },
            "gpi": { "type": "integer", "minimum": 0 },
            "phobicAvoidance": { "type": "integer", "minimum": 0 },
            "obsessiveCompulsive": { "type": "integer", "minimum": 0 },
            "psychoticism": { "type": "integer", "minimum": 0 },
            "suicideRisk": { "type": "integer", "minimum": 0 },
            "violenceRisk": { "type": "integer", "minimum": 0 }
          }
        },
        "scaleLevels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depression", "anxiety", "anger", "gpi", "phobicAvoidance", "obsessiveCompulsive", "psychoticism", "suicideRisk", "violenceRisk"],
          "properties": {
            "depression": { "$ref": "#/$defs/level" },
            "anxiety": { "$ref": "#/$defs/level" },
            "anger": { "$ref": "#/$defs/level" },
            "gpi": { "$ref": "#/$defs/level" },
            "phobicAvoidance": { "$ref": "#/$defs/level" },
            "obsessiveCompulsive": { "$ref": "#/$defs/level" },
            "psychoticism": { "$ref": "#/$defs/level" },
            "suicideRisk": { "$ref": "#/$defs/level" },
            "violenceRisk": { "$ref": "#/$defs/level" }
          }
        },
        "subscales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "domain", "score", "level"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "domain": { "type": "string", "minLength": 1, "maxLength": 80 },
              "score": { "type": "integer", "minimum": 0 },
              "level": { "$ref": "#/$defs/level" }
            }
          }
        },
        "criticalResponses": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "score", "directReviewRequired"],
            "properties": {
              "item": { "type": "string", "minLength": 1, "maxLength": 120 },
              "score": { "type": "integer", "minimum": 0 },
              "directReviewRequired": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "level": { "enum": ["minimal", "mild", "moderate", "severe"] }
  }
}

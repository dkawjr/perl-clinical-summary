{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/clinical-summary.schema.json",
  "title": "PERL clinical summary narrative",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "audience", "provider", "version", "generatedAt", "source"],
  "properties": {
    "text": { "type": "string", "minLength": 40, "maxLength": 6000 },
    "audience": { "enum": ["clinician", "care", "payer", "admin"] },
    "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "promptVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputSchemaVersion": { "const": "perl-scored-profile/1.0" },
    "outputSchemaVersion": { "const": "perl-generation-bundle/1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "source": { "enum": ["generated", "reviewer"] },
    "actor": { "type": "string", "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 }
  }
}

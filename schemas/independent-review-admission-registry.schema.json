{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/independent-review-admission-registry.schema.json",
  "title": "PERL independent-review admission registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "registryId", "version", "issuedAt", "expiresAt", "keys"],
  "properties": {
    "contractVersion": { "const": "perl-independent-review-admission-registry/1.0" },
    "registryId": { "type": "string", "pattern": "^FF-REVIEW-ADMISSION-REGISTRY-[A-Z0-9-]{3,80}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "keys": {
      "type": "array", "minItems": 0, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyId", "algorithm", "purpose", "publicKeyPem", "notBefore", "notAfter"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^FF-REVIEW-ADMISSION-KEY-[A-Z0-9-]{3,80}$" },
          "algorithm": { "const": "Ed25519" },
          "purpose": { "$ref": "#/$defs/purpose" },
          "publicKeyPem": { "type": "string", "maxLength": 1024 },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "purpose": { "enum": ["authoritative-source-contract-acceptance", "representative-case-set-freeze", "clinical-standard-acceptance", "evaluator-charter-attestation", "legal-permission-attestation", "privacy-permission-attestation", "independent-review-protocol-freeze"] }
  }
}

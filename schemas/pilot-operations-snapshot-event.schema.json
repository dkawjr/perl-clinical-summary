{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.example/schemas/pilot-operations-snapshot-event.schema.json",
  "title": "PERL Provider Pilot Operations Snapshot Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "type", "status", "planFingerprint", "counts", "evidenceContext", "decision",
    "sourceClaimsVerifiedExternally", "sourceRecordsIncluded", "siteIdentityVerified", "counselorRosterReceived", "licensureVerified", "authorityVerified", "agreementExecuted", "budgetApproved", "trainingCompleted", "dataPathApproved", "phiReceived", "planAccepted", "pilotAuthorized", "pilotStarted", "outcomeEstablished", "renewalApproved", "expansionApproved", "productionReleaseAuthorized", "patientUseAuthorized", "actor", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "$ref": "#/$defs/chain" },
    "contractVersion": { "const": "perl-provider-pilot-operations-plan/1.0" },
    "type": { "const": "provider-pilot-operations-snapshot-recorded" },
    "status": { "const": "source-plan-assembled-external-authorization-required" },
    "planFingerprint": { "$ref": "#/$defs/hash" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidatePathways", "sourceWorkingPlans", "sourceReportedCaseload", "workingMonths", "quarterlyReviews", "trainingModules", "measures", "admissionGates", "localReadinessCurrent", "externalAccepted", "sitesVerified", "pilotsAuthorized"],
      "properties": {
        "candidatePathways": { "const": 2 },
        "sourceWorkingPlans": { "const": 1 },
        "sourceReportedCaseload": { "const": 50 },
        "workingMonths": { "const": 10 },
        "quarterlyReviews": { "const": 4 },
        "trainingModules": { "const": 4 },
        "measures": { "const": 6 },
        "admissionGates": { "const": 7 },
        "localReadinessCurrent": { "type": "integer", "minimum": 0, "maximum": 7 },
        "externalAccepted": { "type": "integer", "minimum": 0, "maximum": 7 },
        "sitesVerified": { "const": 0 },
        "pilotsAuthorized": { "const": 0 }
      }
    },
    "evidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateSchemaVersion", "readinessStateHash", "decisionExchangeFingerprint", "reportContract", "intendedUseContract", "chainHeads"],
      "properties": {
        "stateSchemaVersion": { "type": "integer", "minimum": 31, "maximum": 33 },
        "readinessStateHash": { "$ref": "#/$defs/hash" },
        "decisionExchangeFingerprint": { "$ref": "#/$defs/hash" },
        "reportContract": { "type": "string", "minLength": 2, "maxLength": 120 },
        "intendedUseContract": { "type": "string", "minLength": 2, "maxLength": 120 },
        "chainHeads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intendedUse", "languageReview", "candidateTrial", "clinicalStandard", "independentReview", "decisionExchange"],
          "properties": {
            "intendedUse": { "$ref": "#/$defs/chain" },
            "languageReview": { "$ref": "#/$defs/chain" },
            "candidateTrial": { "$ref": "#/$defs/chain" },
            "clinicalStandard": { "$ref": "#/$defs/chain" },
            "independentReview": { "$ref": "#/$defs/chain" },
            "decisionExchange": { "$ref": "#/$defs/chain" }
          }
        }
      }
    },
    "decision": { "const": "site-specific-pilot-authorization-remains-external" },
    "sourceClaimsVerifiedExternally": { "const": false },
    "sourceRecordsIncluded": { "const": false },
    "siteIdentityVerified": { "const": false },
    "counselorRosterReceived": { "const": false },
    "licensureVerified": { "const": false },
    "authorityVerified": { "const": false },
    "agreementExecuted": { "const": false },
    "budgetApproved": { "const": false },
    "trainingCompleted": { "const": false },
    "dataPathApproved": { "const": false },
    "phiReceived": { "const": false },
    "planAccepted": { "const": false },
    "pilotAuthorized": { "const": false },
    "pilotStarted": { "const": false },
    "outcomeEstablished": { "const": false },
    "renewalApproved": { "const": false },
    "expansionApproved": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 180, "maxLength": 600 },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "chain": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" }
  }
}

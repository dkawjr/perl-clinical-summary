{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/identity-access-event.schema.json",
  "title": "PERL authenticated access decision event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sequence",
    "previousHash",
    "contractVersion",
    "eventType",
    "actorRef",
    "keyId",
    "roles",
    "tokenFingerprint",
    "policyFingerprint",
    "issuerFingerprint",
    "method",
    "routeClass",
    "permission",
    "authenticatedAt",
    "signatureVerified",
    "authorizationGranted",
    "bearerTokenStored",
    "passwordStored",
    "humanNameStored",
    "phiStored",
    "boundary",
    "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
    "contractVersion": { "const": "perl-authenticated-access-decision/1.0" },
    "eventType": { "const": "authenticated-api-access-granted" },
    "actorRef": { "type": "string", "pattern": "^FF-ID-[A-Z0-9][A-Z0-9._-]{3,41}$" },
    "keyId": { "type": "string", "pattern": "^FF-IDENTITY-KEY-[A-Z0-9][A-Z0-9-]{5,63}$" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "licensed-clinician",
          "clinical-lead",
          "calibration-reviewer",
          "integration-operator",
          "operations-operator",
          "governance-owner",
          "read-only-auditor"
        ]
      }
    },
    "tokenFingerprint": { "$ref": "#/$defs/hash" },
    "policyFingerprint": { "$ref": "#/$defs/hash" },
    "issuerFingerprint": { "$ref": "#/$defs/hash" },
    "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"] },
    "routeClass": { "enum": ["clinical-record", "calibration", "integration", "operations", "governance", "safety", "change-control"] },
    "permission": {
      "enum": [
        "clinical:review",
        "clinical:approve",
        "calibration:operate",
        "integration:operate",
        "operations:operate",
        "governance:verify",
        "safety:report",
        "safety:manage",
        "change:manage"
      ]
    },
    "authenticatedAt": { "type": "string", "format": "date-time" },
    "signatureVerified": { "const": true },
    "authorizationGranted": { "const": true },
    "bearerTokenStored": { "const": false },
    "passwordStored": { "const": false },
    "humanNameStored": { "const": false },
    "phiStored": { "const": false },
    "boundary": {
      "const": "This perimeter verifies short-lived externally issued Ed25519 bearer assertions and applies a fixed local route-permission map. It does not issue a token, collect a password, connect an SSO login, verify licensure or employment, resolve a patient or production site, store a bearer token, authorize PHI, replace e-QPASS RBAC, or create clinical, pilot, release, traffic, stop, restart, or care-decision authority."
    },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/delivery-request.schema.json",
  "title": "PERL synthetic attachment delivery request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "requestId", "environment", "assessmentId", "jobId", "idempotencyKey",
    "reportArtifactId", "reportArtifactHash", "preparationReceiptHash", "mediaType", "content",
    "contentHash", "provenance"
  ],
  "properties": {
    "contractVersion": { "const": "perl-attachment-delivery-request/0.1" },
    "requestId": { "type": "string", "format": "uuid" },
    "environment": { "const": "calibration" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "jobId": { "type": "string", "format": "uuid" },
    "idempotencyKey": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$", "minLength": 20, "maxLength": 240 },
    "reportArtifactId": { "type": "string", "format": "uuid" },
    "reportArtifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preparationReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mediaType": { "const": "text/html" },
    "content": { "type": "string", "minLength": 100, "maxLength": 131072 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEventReceiptHash", "findingsReportHash", "renderedContentHash"],
      "properties": {
        "sourceEventReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "findingsReportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "renderedContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "x-status": "synthetic-rehearsal-only",
  "x-phi-approved": false
}

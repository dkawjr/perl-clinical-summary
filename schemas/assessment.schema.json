{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/assessment.schema.json",
  "title": "PERL synthetic scored assessment",
  "description": "Canonical de-identified calibration payload. This schema is not authorization to process PHI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "completedAt", "duration", "status", "reviewer", "source", "itemsAnswered",
    "scales", "subscales", "criticalResponses"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "completedAt": { "type": "string", "minLength": 1, "maxLength": 120 },
    "duration": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
    "status": { "enum": ["priority", "ready", "approved"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": { "type": "string", "pattern": "[Ss][Yy][Nn][Tt][Hh][Ee][Tt][Ii][Cc]", "maxLength": 160 },
    "itemsAnswered": { "const": 105 },
    "scales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depression", "anxiety", "anger", "gpi", "phobicAvoidance", "obsessiveCompulsive", "psychoticism", "suicideRisk", "violenceRisk"],
      "properties": {
        "depression": { "type": "integer", "minimum": 0, "maximum": 104 },
        "anxiety": { "type": "integer", "minimum": 0, "maximum": 116 },
        "anger": { "type": "integer", "minimum": 0, "maximum": 112 },
        "gpi": { "type": "integer", "minimum": 0, "maximum": 420 },
        "phobicAvoidance": { "type": "integer", "minimum": 0, "maximum": 40 },
        "obsessiveCompulsive": { "type": "integer", "minimum": 0, "maximum": 40 },
        "psychoticism": { "type": "integer", "minimum": 0, "maximum": 40 },
        "suicideRisk": { "type": "integer", "minimum": 0, "maximum": 8 },
        "violenceRisk": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "scaleLevels": {
      "description": "Optional source-supplied severity levels. Production adapters preserve these values instead of reconstructing score bands.",
      "type": "object",
      "additionalProperties": false,
      "required": ["depression", "anxiety", "anger", "gpi", "phobicAvoidance", "obsessiveCompulsive", "psychoticism", "suicideRisk", "violenceRisk"],
      "properties": {
        "depression": { "$ref": "#/$defs/severityLevel" },
        "anxiety": { "$ref": "#/$defs/severityLevel" },
        "anger": { "$ref": "#/$defs/severityLevel" },
        "gpi": { "$ref": "#/$defs/severityLevel" },
        "phobicAvoidance": { "$ref": "#/$defs/severityLevel" },
        "obsessiveCompulsive": { "$ref": "#/$defs/severityLevel" },
        "psychoticism": { "$ref": "#/$defs/severityLevel" },
        "suicideRisk": { "$ref": "#/$defs/severityLevel" },
        "violenceRisk": { "$ref": "#/$defs/severityLevel" }
      }
    },
    "subscales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "domain", "score", "level", "evidence"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "domain": { "type": "string", "minLength": 1, "maxLength": 80 },
          "score": { "type": "integer", "minimum": 0, "maximum": 120 },
          "level": { "enum": ["minimal", "mild", "moderate", "severe"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "criticalResponses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "score", "note"],
        "properties": {
          "item": { "type": "string", "minLength": 1, "maxLength": 120 },
          "score": { "type": "integer", "minimum": 0, "maximum": 8 },
          "directReviewRequired": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "severityLevel": { "enum": ["minimal", "mild", "moderate", "severe"] }
  }
}

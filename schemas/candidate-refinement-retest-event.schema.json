{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.example/schemas/candidate-refinement-retest-event.schema.json",
  "title": "PERL Candidate Refinement and Retest Cycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "eventType", "status", "cycleId", "cycleNumber", "laneId", "laneLabel", "signalSnapshot", "intervention", "evidence", "retestPolicy", "retestEnvelopes", "contentBoundary", "candidateIdentityPublished", "providerIdentityPublished", "reviewerIdentityPublished", "authorMappingPublished", "reviewerIdentityVerified", "counselorQualificationVerified", "candidateRunExternallyVerified", "providerVerified", "modelModificationPerformed", "candidateRetestExecuted", "candidateRetestReturnReceived", "retestReviewCompleted", "accuracyEstablished", "reliabilityEstablished", "safetyEstablished", "usefulnessEstablished", "clinicalStandardMet", "clinicalValidation", "engineRanked", "engineSelected", "carePlanChanged", "pilotAuthorized", "productionReleaseAuthorized", "patientUseAuthorized", "actorCodeHash", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "contractVersion": { "const": "perl-candidate-refinement-retest/1.0" },
    "eventType": { "const": "candidate-refinement-cycle-scoped" },
    "status": { "const": "retest-kit-issued-awaiting-manual-return" },
    "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
    "cycleNumber": { "type": "integer", "minimum": 1 },
    "laneId": { "enum": ["lane-i", "lane-ii", "lane-iii"] },
    "laneLabel": { "enum": ["Lane I", "Lane II", "Lane III"] },
    "signalSnapshot": { "$ref": "#/$defs/signalSnapshot" },
    "intervention": { "$ref": "#/$defs/intervention" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "retestPolicy": { "$ref": "#/$defs/retestPolicy" },
    "retestEnvelopes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/retestEnvelope" }
    },
    "contentBoundary": { "$ref": "#/$defs/contentBoundary" },
    "candidateIdentityPublished": { "const": false },
    "providerIdentityPublished": { "const": false },
    "reviewerIdentityPublished": { "const": false },
    "authorMappingPublished": { "const": false },
    "reviewerIdentityVerified": { "const": false },
    "counselorQualificationVerified": { "const": false },
    "candidateRunExternallyVerified": { "const": false },
    "providerVerified": { "const": false },
    "modelModificationPerformed": { "const": false },
    "candidateRetestExecuted": { "const": false },
    "candidateRetestReturnReceived": { "const": false },
    "retestReviewCompleted": { "const": false },
    "accuracyEstablished": { "const": false },
    "reliabilityEstablished": { "const": false },
    "safetyEstablished": { "const": false },
    "usefulnessEstablished": { "const": false },
    "clinicalStandardMet": { "const": false },
    "clinicalValidation": { "const": false },
    "engineRanked": { "const": false },
    "engineSelected": { "const": false },
    "carePlanChanged": { "const": false },
    "pilotAuthorized": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actorCodeHash": { "$ref": "#/$defs/hash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 300, "maxLength": 1200 },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "correctionFlag", "label", "evidenceCount", "caseCount", "reviewerCount", "evidenceEventHashes", "sourceSignalHash", "snapshotHash"],
      "properties": {
        "signalId": { "type": "string", "pattern": "^lane-i{1,3}:(factual-mismatch|unsupported-overreach|material-omission|tone-or-clarity|workflow-usefulness)$" },
        "correctionFlag": { "enum": ["factual-mismatch", "unsupported-overreach", "material-omission", "tone-or-clarity", "workflow-usefulness"] },
        "label": { "type": "string", "minLength": 4, "maxLength": 80 },
        "evidenceCount": { "type": "integer", "minimum": 1 },
        "caseCount": { "type": "integer", "minimum": 3 },
        "reviewerCount": { "type": "integer", "minimum": 2 },
        "evidenceEventHashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
        "sourceSignalHash": { "$ref": "#/$defs/hash" },
        "snapshotHash": { "$ref": "#/$defs/hash" }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetMeasure", "iterationGoal", "changesDeclared", "changesPerformed"],
      "properties": {
        "type": { "enum": ["evidence-grounding-constraint", "diagnostic-restraint-constraint", "material-signal-coverage", "tone-and-clarity-structure", "workflow-usefulness-structure"] },
        "targetMeasure": { "enum": ["evidence-fidelity", "clinical-restraint", "conversation-usefulness"] },
        "iterationGoal": { "enum": ["reduce-repeated-correction", "preserve-fidelity-and-restraint", "reduce-material-burden", "improve-usefulness-without-overreach"] },
        "changesDeclared": { "const": true },
        "changesPerformed": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateReviewChainHead", "candidateReviewDeskFingerprint", "candidateReturnChainHead", "clinicalStandardHash", "candidateTrialProtocolFingerprint"],
      "properties": {
        "candidateReviewChainHead": { "$ref": "#/$defs/hash" },
        "candidateReviewDeskFingerprint": { "$ref": "#/$defs/hash" },
        "candidateReturnChainHead": { "$ref": "#/$defs/hash" },
        "clinicalStandardHash": { "$ref": "#/$defs/hash" },
        "candidateTrialProtocolFingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "retestPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseSetSize", "sameCasesRequired", "oneInterventionPerCycle", "blindReReviewRequired", "independentAccuracyReliabilityReviewRequired", "manualProviderExecutionOnly", "retestProtocolFingerprint"],
      "properties": {
        "caseSetSize": { "const": 3 },
        "sameCasesRequired": { "const": true },
        "oneInterventionPerCycle": { "const": true },
        "blindReReviewRequired": { "const": true },
        "independentAccuracyReliabilityReviewRequired": { "const": true },
        "manualProviderExecutionOnly": { "const": true },
        "retestProtocolFingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "retestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeId", "cycleId", "laneId", "caseId", "caseFingerprint", "baselineArtifactHash", "retestProtocolFingerprint", "expectedReturnContract", "sourceContentIncluded", "baselineSummaryIncluded", "providerIdentityIncluded", "modelIdentityIncluded", "promptContentIncluded", "endpointIncluded", "credentialIncluded", "phiIncluded"],
      "properties": {
        "envelopeId": { "type": "string", "pattern": "^FF-CANDIDATE-RETEST-[A-F0-9-]{20,80}$" },
        "cycleId": { "type": "string", "pattern": "^FF-REFINEMENT-CYCLE-[A-F0-9-]{20,80}$" },
        "laneId": { "enum": ["lane-i", "lane-ii", "lane-iii"] },
        "caseId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]{3,40}$" },
        "caseFingerprint": { "$ref": "#/$defs/hash" },
        "baselineArtifactHash": { "$ref": "#/$defs/hash" },
        "retestProtocolFingerprint": { "$ref": "#/$defs/hash" },
        "expectedReturnContract": { "const": "perl-candidate-retest-return/1.0" },
        "sourceContentIncluded": { "const": false },
        "baselineSummaryIncluded": { "const": false },
        "providerIdentityIncluded": { "const": false },
        "modelIdentityIncluded": { "const": false },
        "promptContentIncluded": { "const": false },
        "endpointIncluded": { "const": false },
        "credentialIncluded": { "const": false },
        "phiIncluded": { "const": false }
      }
    },
    "contentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoredSourceIncluded", "baselineSummaryIncluded", "revisedSummaryIncluded", "rawProviderResponseIncluded", "findingsContentIncluded", "providerIdentityIncluded", "modelIdentityIncluded", "promptContentIncluded", "reviewerIdentityIncluded", "counselorIdentityIncluded", "patientIdentifiersIncluded", "credentialsIncluded", "phiIncluded"],
      "properties": {
        "scoredSourceIncluded": { "const": false },
        "baselineSummaryIncluded": { "const": false },
        "revisedSummaryIncluded": { "const": false },
        "rawProviderResponseIncluded": { "const": false },
        "findingsContentIncluded": { "const": false },
        "providerIdentityIncluded": { "const": false },
        "modelIdentityIncluded": { "const": false },
        "promptContentIncluded": { "const": false },
        "reviewerIdentityIncluded": { "const": false },
        "counselorIdentityIncluded": { "const": false },
        "patientIdentifiersIncluded": { "const": false },
        "credentialsIncluded": { "const": false },
        "phiIncluded": { "const": false }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.local/schemas/language-review-packet-event.schema.json",
  "title": "PERL language review packet event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "type", "status",
    "packetId", "packetHash", "packetVersion", "corpusFingerprint", "intendedUseDraftHash",
    "copySurfaceCount", "reviewQuestionCount", "acceptancesRequired", "acceptancesRecorded",
    "executiveSponsorAccepted", "clinicalLeadAccepted", "legalApproved", "privacySecurityAccepted",
    "eqpassOwnerAccepted", "disclaimerApproved", "languageFrozen", "clinicalValidation",
    "pilotAuthorized", "productionReleaseAuthorized", "patientUseAuthorized",
    "actor", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "oneOf": [{ "const": "GENESIS" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
    "contractVersion": { "const": "perl-language-review-packet/1.0" },
    "type": { "const": "language-review-packet-sealed" },
    "status": { "const": "counsel-clinical-review-required" },
    "packetId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "packetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "packetVersion": { "type": "integer", "minimum": 1 },
    "corpusFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intendedUseDraftHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "copySurfaceCount": { "const": 9 },
    "reviewQuestionCount": { "const": 6 },
    "acceptancesRequired": { "const": 5 },
    "acceptancesRecorded": { "const": 0 },
    "executiveSponsorAccepted": { "const": false },
    "clinicalLeadAccepted": { "const": false },
    "legalApproved": { "const": false },
    "privacySecurityAccepted": { "const": false },
    "eqpassOwnerAccepted": { "const": false },
    "disclaimerApproved": { "const": false },
    "languageFrozen": { "const": false },
    "clinicalValidation": { "const": false },
    "pilotAuthorized": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 100, "maxLength": 420 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

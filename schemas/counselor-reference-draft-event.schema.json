{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.local/schemas/counselor-reference-draft-event.schema.json",
  "title": "PERL source-only counselor reference draft event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "type", "assessmentId", "caseSet", "sourceProfile",
    "sourceProfileHash", "authoringMode", "summary", "themes", "questions", "toneMarkers", "criticalReviewDisposition",
    "sourceSurfaceIncludesGeneratedContent", "authorshipIndependenceEstablished", "counselorIdentityVerified",
    "referenceAccepted", "adjudicationCompleted", "protocolFrozen", "accuracyEstablished", "reliabilityEstablished",
    "clinicalValidation", "pilotAuthorized", "productionReleaseAuthorized", "patientUseAuthorized", "actor", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F-]{20,40}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "contractVersion": { "const": "perl-counselor-reference-draft/1.0" },
    "type": { "const": "counselor-reference-draft-recorded" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]{3,40}$" },
    "caseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "partition", "referenceVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "minLength": 1 },
        "partition": { "type": "string", "minLength": 1 },
        "referenceVersion": { "type": "string", "minLength": 1 }
      }
    },
    "sourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection", "assessmentId", "completedAt", "itemsAnswered", "source", "scales", "subscales", "safety",
        "boundary", "generatedContentIncluded", "counselorReferenceIncluded"
      ],
      "properties": {
        "projection": { "const": "scored-profile-v1" },
        "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]{3,40}$" },
        "completedAt": { "type": "string", "minLength": 1 },
        "itemsAnswered": { "type": "integer", "minimum": 0, "maximum": 105 },
        "source": { "type": "string", "minLength": 3 },
        "scales": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/score" }
        },
        "subscales": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "domain", "score", "level", "evidence"],
            "properties": {
              "label": { "type": "string", "minLength": 2 },
              "domain": { "type": "string", "minLength": 2 },
              "score": { "type": "number", "minimum": 0 },
              "level": { "oneOf": [{ "type": "null" }, { "enum": ["minimal", "mild", "moderate", "severe"] }] },
              "evidence": { "type": "string", "minLength": 2 }
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directReviewRequired", "highlightedResponses", "instruction"],
          "properties": {
            "directReviewRequired": { "type": "boolean" },
            "highlightedResponses": { "type": "integer", "minimum": 0 },
            "instruction": { "type": "string", "minLength": 30 }
          }
        },
        "boundary": { "type": "string", "minLength": 120 },
        "generatedContentIncluded": { "const": false },
        "counselorReferenceIncluded": { "const": false }
      }
    },
    "sourceProfileHash": { "$ref": "#/$defs/hash" },
    "authoringMode": { "const": "source-only" },
    "summary": { "type": "string", "minLength": 80, "maxLength": 1500 },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body", "confidence", "evidence", "uncertainty"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 180 },
          "body": { "type": "string", "minLength": 40, "maxLength": 1000 },
          "confidence": { "enum": ["Low", "Moderate", "High"] },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
          "uncertainty": { "type": "string", "minLength": 30, "maxLength": 500 }
        }
      }
    },
    "questions": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 12, "maxLength": 300, "pattern": "\\?$" } },
    "toneMarkers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["indicator-language", "explicit-uncertainty", "plain-clinical-language", "next-conversation", "critical-route-visible"] }
    },
    "criticalReviewDisposition": { "enum": ["requires-direct-review", "routine-verification"] },
    "sourceSurfaceIncludesGeneratedContent": { "const": false },
    "authorshipIndependenceEstablished": { "const": false },
    "counselorIdentityVerified": { "const": false },
    "referenceAccepted": { "const": false },
    "adjudicationCompleted": { "const": false },
    "protocolFrozen": { "const": false },
    "accuracyEstablished": { "const": false },
    "reliabilityEstablished": { "const": false },
    "clinicalValidation": { "const": false },
    "pilotAuthorized": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 150 },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "score", "level"],
      "properties": {
        "key": { "type": "string", "minLength": 2 },
        "label": { "type": "string", "minLength": 2 },
        "score": { "type": "number", "minimum": 0 },
        "level": { "enum": ["minimal", "mild", "moderate", "severe"] }
      }
    }
  }
}

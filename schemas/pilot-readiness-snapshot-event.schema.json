{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/pilot-readiness-snapshot-event.schema.json",
  "title": "PERL pilot-readiness snapshot event",
  "description": "A hash-linked consolidation of local synthetic evidence and unresolved external authority. It cannot authorize a pilot or clinical release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "type", "status", "scope",
    "decision", "gates", "gateCounts", "authorityRegister", "authorityCounts", "evidenceHeads",
    "readinessStateHash", "productionReadinessClaimed", "externalApprovalsRecorded",
    "productionOwnersAssigned", "pilotAuthorizationRecorded", "clinicalReleaseAuthorized",
    "actor", "startedAt", "completedAt", "durationMs", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
    "contractVersion": { "const": "perl-pilot-readiness-snapshot/1.0" },
    "type": { "const": "pilot-readiness-snapshot-recorded" },
    "status": { "const": "pilot-authorization-blocked" },
    "scope": { "const": "local-synthetic-readiness-dossier" },
    "decision": { "const": "pilot-authorization-blocked" },
    "gates": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "category", "ownerRoles", "status", "detail", "evidenceHash", "productionAccepted"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{3,63}$" },
        "label": { "type": "string", "minLength": 8, "maxLength": 96 },
        "category": { "enum": ["local-pattern", "external-authority"] },
        "ownerRoles": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{3,63}$" }, "uniqueItems": true },
        "status": { "enum": ["local-evidence-current", "local-evidence-required", "external-decision-required"] },
        "detail": { "type": "string", "minLength": 12, "maxLength": 220 },
        "evidenceHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "productionAccepted": { "const": false }
      }}
    },
    "gateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["localCurrent", "localRequired", "externalDecisionRequired", "total"],
      "properties": {
        "localCurrent": { "type": "integer", "minimum": 0, "maximum": 7 },
        "localRequired": { "type": "integer", "minimum": 0, "maximum": 7 },
        "externalDecisionRequired": { "const": 7 },
        "total": { "const": 14 }
      }
    },
    "authorityRegister": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "name", "status"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{3,63}$" },
        "label": { "type": "string", "minLength": 8, "maxLength": 96 },
        "name": { "oneOf": [{ "type": "string", "minLength": 2, "maxLength": 64 }, { "type": "null" }] },
        "status": { "enum": ["confirmed-source-owner", "provisional-source-owner", "unassigned"] }
      }}
    },
    "authorityCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "provisional", "unassigned", "total"],
      "properties": {
        "confirmed": { "const": 1 }, "provisional": { "const": 1 }, "unassigned": { "const": 8 }, "total": { "const": 10 }
      }
    },
    "evidenceHeads": {
      "type": "object", "additionalProperties": false,
      "required": ["engineeringRegression", "reportArtifacts", "deliveryOutbox", "recovery", "rollback", "monitoring", "incidentResponse", "integrity"],
      "properties": {
        "engineeringRegression": { "$ref": "#/$defs/hash" },
        "reportArtifacts": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "deliveryOutbox": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "recovery": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "rollback": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "monitoring": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "incidentResponse": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/hash" }] },
        "integrity": { "$ref": "#/$defs/hash" }
      }
    },
    "readinessStateHash": { "$ref": "#/$defs/hash" },
    "productionReadinessClaimed": { "const": false },
    "externalApprovalsRecorded": { "const": false },
    "productionOwnersAssigned": { "const": false },
    "pilotAuthorizationRecorded": { "const": false },
    "clinicalReleaseAuthorized": { "const": false },
    "actor": { "type": "string", "minLength": 2, "maxLength": 48 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "note": { "type": "string", "minLength": 1, "maxLength": 420 },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}

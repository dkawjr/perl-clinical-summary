{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/schemas/candidate-retest-disposition-event.schema.json",
  "title": "PERL candidate retest disposition ledger event",
  "oneOf": [{ "$ref": "#/$defs/challengeEvent" }, { "$ref": "#/$defs/attestationEvent" }],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "chainHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "claims": {
      "independentAccuracyDispositionRecorded": { "type": "boolean" }, "independentReliabilityDispositionRecorded": { "type": "boolean" }, "clinicalStandardSatisfactionRecorded": { "type": "boolean" }, "independentResultFrozen": { "type": "boolean" }, "cycleCloseRecommended": { "type": "boolean" }, "candidateAdvancementRecommended": { "type": "boolean" },
      "externalModelExecutionVerified": { "const": false }, "generalizedAccuracyEstablished": { "const": false }, "generalizedReliabilityEstablished": { "const": false }, "comparativeImprovementEstablished": { "const": false }, "clinicalPerformanceEstablished": { "const": false }, "safetyEstablished": { "const": false }, "clinicalValidation": { "const": false }, "engineRanked": { "const": false }, "engineSelected": { "const": false }, "cycleClosed": { "const": false }, "carePlanChanged": { "const": false }, "pilotAuthorized": { "const": false }, "deploymentAuthorized": { "const": false }, "productionReleaseAuthorized": { "const": false }, "trafficActivationAuthorized": { "const": false }, "patientUseAuthorized": { "const": false }
    },
    "baseProperties": {
      "id": { "type": "string", "pattern": "^[0-9a-f-]{20,40}$" }, "sequence": { "type": "integer", "minimum": 1 }, "previousHash": { "$ref": "#/$defs/chainHash" }, "contractVersion": { "const": "perl-candidate-retest-independent-disposition/1.0" }, "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" }, "createdAt": { "type": "string", "format": "date-time" }, "boundary": { "type": "string", "minLength": 900 }, "hash": { "$ref": "#/$defs/hash" }
    },
    "challengeEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "previousHash", "eventType", "contractVersion", "challenge", "actor", "createdAt", "independentAccuracyDispositionRecorded", "independentReliabilityDispositionRecorded", "clinicalStandardSatisfactionRecorded", "independentResultFrozen", "cycleCloseRecommended", "candidateAdvancementRecommended", "externalModelExecutionVerified", "generalizedAccuracyEstablished", "generalizedReliabilityEstablished", "comparativeImprovementEstablished", "clinicalPerformanceEstablished", "safetyEstablished", "clinicalValidation", "engineRanked", "engineSelected", "cycleClosed", "carePlanChanged", "pilotAuthorized", "deploymentAuthorized", "productionReleaseAuthorized", "trafficActivationAuthorized", "patientUseAuthorized", "boundary", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/baseProperties/id" }, "sequence": { "$ref": "#/$defs/baseProperties/sequence" }, "previousHash": { "$ref": "#/$defs/chainHash" }, "eventType": { "const": "candidate-retest-disposition-challenge-issued" }, "contractVersion": { "const": "perl-candidate-retest-independent-disposition/1.0" }, "challenge": { "$ref": "candidate-retest-disposition-challenge.schema.json" }, "actor": { "$ref": "#/$defs/baseProperties/actor" }, "createdAt": { "$ref": "#/$defs/baseProperties/createdAt" },
        "independentAccuracyDispositionRecorded": { "const": false }, "independentReliabilityDispositionRecorded": { "const": false }, "clinicalStandardSatisfactionRecorded": { "const": false }, "independentResultFrozen": { "const": false }, "cycleCloseRecommended": { "const": false }, "candidateAdvancementRecommended": { "const": false },
        "externalModelExecutionVerified": { "const": false }, "generalizedAccuracyEstablished": { "const": false }, "generalizedReliabilityEstablished": { "const": false }, "comparativeImprovementEstablished": { "const": false }, "clinicalPerformanceEstablished": { "const": false }, "safetyEstablished": { "const": false }, "clinicalValidation": { "const": false }, "engineRanked": { "const": false }, "engineSelected": { "const": false }, "cycleClosed": { "const": false }, "carePlanChanged": { "const": false }, "pilotAuthorized": { "const": false }, "deploymentAuthorized": { "const": false }, "productionReleaseAuthorized": { "const": false }, "trafficActivationAuthorized": { "const": false }, "patientUseAuthorized": { "const": false }, "boundary": { "$ref": "#/$defs/baseProperties/boundary" }, "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "attestationEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "previousHash", "eventType", "contractVersion", "attestation", "attestationFingerprint", "keyFingerprint", "actor", "createdAt", "independentAccuracyDispositionRecorded", "independentReliabilityDispositionRecorded", "clinicalStandardSatisfactionRecorded", "independentResultFrozen", "cycleCloseRecommended", "candidateAdvancementRecommended", "externalModelExecutionVerified", "generalizedAccuracyEstablished", "generalizedReliabilityEstablished", "comparativeImprovementEstablished", "clinicalPerformanceEstablished", "safetyEstablished", "clinicalValidation", "engineRanked", "engineSelected", "cycleClosed", "carePlanChanged", "pilotAuthorized", "deploymentAuthorized", "productionReleaseAuthorized", "trafficActivationAuthorized", "patientUseAuthorized", "boundary", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/baseProperties/id" }, "sequence": { "$ref": "#/$defs/baseProperties/sequence" }, "previousHash": { "$ref": "#/$defs/chainHash" }, "eventType": { "const": "candidate-retest-disposition-attestation-verified" }, "contractVersion": { "const": "perl-candidate-retest-independent-disposition/1.0" }, "attestation": { "$ref": "candidate-retest-disposition-attestation.schema.json" }, "attestationFingerprint": { "$ref": "#/$defs/hash" }, "keyFingerprint": { "$ref": "#/$defs/hash" }, "actor": { "$ref": "#/$defs/baseProperties/actor" }, "createdAt": { "$ref": "#/$defs/baseProperties/createdAt" },
        "independentAccuracyDispositionRecorded": { "type": "boolean" }, "independentReliabilityDispositionRecorded": { "type": "boolean" }, "clinicalStandardSatisfactionRecorded": { "type": "boolean" }, "independentResultFrozen": { "type": "boolean" }, "cycleCloseRecommended": { "type": "boolean" }, "candidateAdvancementRecommended": { "type": "boolean" },
        "externalModelExecutionVerified": { "const": false }, "generalizedAccuracyEstablished": { "const": false }, "generalizedReliabilityEstablished": { "const": false }, "comparativeImprovementEstablished": { "const": false }, "clinicalPerformanceEstablished": { "const": false }, "safetyEstablished": { "const": false }, "clinicalValidation": { "const": false }, "engineRanked": { "const": false }, "engineSelected": { "const": false }, "cycleClosed": { "const": false }, "carePlanChanged": { "const": false }, "pilotAuthorized": { "const": false }, "deploymentAuthorized": { "const": false }, "productionReleaseAuthorized": { "const": false }, "trafficActivationAuthorized": { "const": false }, "patientUseAuthorized": { "const": false }, "boundary": { "$ref": "#/$defs/baseProperties/boundary" }, "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

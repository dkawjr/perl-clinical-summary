{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focused-future.local/schemas/model-trial-preflight-event.schema.json",
  "title": "PERL model-trial metadata preflight event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "contractVersion", "type", "status", "requestFingerprint", "manifestHash", "trialIdHash",
    "candidateSnapshots", "candidateResults", "counts", "shortlistMetadataComplete", "evidenceSnapshot", "decision",
    "credentialsReceived", "endpointReceived", "fileBytesReceived", "modelOutputReceived", "recordLevelDataReceived", "patientIdentifiersReceived",
    "rawResponsesReceived", "phiReceived", "externalTransferPerformed", "vendorClaimsVerified", "securityApproved", "privacyApproved",
    "clinicalPerformanceEstablished", "independentReviewComplete", "engineSelected", "phiApproved", "pilotAuthorized",
    "productionReleaseAuthorized", "patientUseAuthorized", "actor", "createdAt", "note", "hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "contractVersion": { "const": "perl-model-trial-preflight/1.0" },
    "type": { "const": "model-trial-metadata-preflight-recorded" },
    "status": { "enum": ["metadata-incomplete", "metadata-complete-unverified"] },
    "requestFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trialIdHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateSnapshots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/candidate01" },
        { "$ref": "#/$defs/candidate02" },
        { "$ref": "#/$defs/candidate03" }
      ],
      "items": false
    },
    "candidateResults": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/candidateResult" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotsRequired", "candidatesDeclared", "metadataComplete", "missing", "domainEvidenceRequired", "domainEvidenceDeclared"],
      "properties": {
        "slotsRequired": { "const": 3 },
        "candidatesDeclared": { "type": "integer", "minimum": 0, "maximum": 3 },
        "metadataComplete": { "type": "integer", "minimum": 0, "maximum": 3 },
        "missing": { "type": "integer", "minimum": 0, "maximum": 3 },
        "domainEvidenceRequired": { "const": 18 },
        "domainEvidenceDeclared": { "type": "integer", "minimum": 0, "maximum": 18 }
      }
    },
    "shortlistMetadataComplete": { "type": "boolean" },
    "evidenceSnapshot": { "$ref": "#/$defs/evidenceSnapshot" },
    "decision": { "const": "engine-selection-not-authorized" },
    "credentialsReceived": { "const": false },
    "endpointReceived": { "const": false },
    "fileBytesReceived": { "const": false },
    "modelOutputReceived": { "const": false },
    "recordLevelDataReceived": { "const": false },
    "patientIdentifiersReceived": { "const": false },
    "rawResponsesReceived": { "const": false },
    "phiReceived": { "const": false },
    "externalTransferPerformed": { "const": false },
    "vendorClaimsVerified": { "const": false },
    "securityApproved": { "const": false },
    "privacyApproved": { "const": false },
    "clinicalPerformanceEstablished": { "const": false },
    "independentReviewComplete": { "const": false },
    "engineSelected": { "const": false },
    "phiApproved": { "const": false },
    "pilotAuthorized": { "const": false },
    "productionReleaseAuthorized": { "const": false },
    "patientUseAuthorized": { "const": false },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{1,47}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "minLength": 120, "maxLength": 500 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "domainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainId", "status", "evidenceRef"],
      "properties": {
        "domainId": { "enum": ["privacy-use", "security-architecture", "technical-behavior", "clinical-evaluation", "operational-fit", "governance-change"] },
        "status": { "enum": ["not-supplied", "metadata-declared-unverified"] },
        "evidenceRef": { "type": ["string", "null"], "pattern": "^FF-EVIDENCE-[A-Z0-9][A-Z0-9._-]{2,79}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "status", "providerId", "modelVersion", "hostingPattern", "region", "domainEvidence"],
      "properties": {
        "slotId": { "enum": ["candidate-01", "candidate-02", "candidate-03"] },
        "status": { "enum": ["not-declared", "metadata-declared-unverified"] },
        "providerId": { "type": ["string", "null"], "maxLength": 120 },
        "modelVersion": { "type": ["string", "null"], "maxLength": 120 },
        "hostingPattern": { "type": ["string", "null"], "enum": [null, "azure-managed", "private-cloud", "vendor-managed", "self-hosted", "other"] },
        "region": { "type": ["string", "null"], "maxLength": 64 },
        "domainEvidence": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/domainEvidence" } }
      }
    },
    "candidate01": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "properties": { "slotId": { "const": "candidate-01" } } }] },
    "candidate02": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "properties": { "slotId": { "const": "candidate-02" } } }] },
    "candidate03": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "properties": { "slotId": { "const": "candidate-03" } } }] },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "metadataDeclared", "providerIdentityDeclared", "modelVersionDeclared", "deploymentMetadataDeclared", "domainEvidenceDeclared", "domainEvidenceComplete", "metadataComplete", "candidateFingerprint"],
      "properties": {
        "slotId": { "enum": ["candidate-01", "candidate-02", "candidate-03"] },
        "metadataDeclared": { "type": "boolean" },
        "providerIdentityDeclared": { "type": "boolean" },
        "modelVersionDeclared": { "type": "boolean" },
        "deploymentMetadataDeclared": { "type": "boolean" },
        "domainEvidenceDeclared": { "type": "integer", "minimum": 0, "maximum": 6 },
        "domainEvidenceComplete": { "type": "boolean" },
        "metadataComplete": { "type": "boolean" },
        "candidateFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseSet", "syntheticCases", "generationRecords", "generationChainHead", "policyVersion", "policyHash", "outputGateCount", "activeProvider"],
      "properties": {
        "caseSet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "manifestHash"],
          "properties": {
            "id": { "type": "string", "minLength": 2, "maxLength": 120 },
            "version": { "type": "string", "minLength": 2, "maxLength": 120 },
            "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "syntheticCases": { "type": "integer", "minimum": 1 },
        "generationRecords": { "type": "integer", "minimum": 1 },
        "generationChainHead": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyVersion": { "type": "string", "minLength": 2, "maxLength": 120 },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputGateCount": { "const": 10 },
        "activeProvider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "mode", "externalTransmission", "phiApproved"],
          "properties": {
            "id": { "type": "string", "minLength": 2, "maxLength": 120 },
            "version": { "type": "string", "minLength": 2, "maxLength": 120 },
            "mode": { "type": "string", "minLength": 2, "maxLength": 120 },
            "externalTransmission": { "type": "boolean" },
            "phiApproved": { "const": false }
          }
        }
      }
    }
  }
}

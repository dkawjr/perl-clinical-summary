{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.org/perl/schemas/runtime-envelope-policy.schema.json",
  "title": "PERL synthetic runtime-envelope policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "status",
    "policyId",
    "version",
    "issuedAt",
    "expiresAt",
    "environment",
    "bindHost",
    "port",
    "publicBaseUrl",
    "dataDirectory",
    "tlsTerminatedUpstream",
    "runAsNonRootRequired",
    "readOnlyRootFilesystemRequired",
    "stateMountReadWrite",
    "secretsMountReadOnly",
    "gracefulShutdownSeconds",
    "livenessPath",
    "readinessPath"
  ],
  "properties": {
    "contractVersion": { "const": "perl-runtime-envelope-policy/1.0" },
    "status": { "const": "approved-for-synthetic-container-rehearsal" },
    "policyId": { "type": "string", "pattern": "^FF-RUNTIME-POLICY-[A-Z0-9_-]{3,48}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "not": { "const": "0.0.0" } },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "environment": { "const": "synthetic-sandbox" },
    "bindHost": { "enum": ["0.0.0.0", "::"] },
    "port": { "const": 4173 },
    "publicBaseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "dataDirectory": { "type": "string", "pattern": "^/[^\\u0000]{1,238}$" },
    "tlsTerminatedUpstream": { "const": true },
    "runAsNonRootRequired": { "const": true },
    "readOnlyRootFilesystemRequired": { "const": true },
    "stateMountReadWrite": { "const": true },
    "secretsMountReadOnly": { "const": true },
    "gracefulShutdownSeconds": { "type": "integer", "minimum": 5, "maximum": 60 },
    "livenessPath": { "const": "/api/live" },
    "readinessPath": { "const": "/api/ready" }
  }
}

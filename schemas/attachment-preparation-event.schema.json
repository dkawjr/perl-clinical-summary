{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusedfuture.example/perl/schemas/attachment-preparation-event.schema.json",
  "title": "PERL synthetic e-QPASS attachment-preparation event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sequence", "previousHash", "type", "contractVersion", "contractStatus", "status",
    "requestHash", "idempotencyKeyHash", "assessmentId", "sourceEventReceiptHash", "sourceEventHash",
    "scoringVersion", "findingsReportVersion", "findingsReportHash", "reportArtifactId",
    "reportArtifactHash", "sourceAssessmentHash", "renderedReportFormat", "renderedMediaType",
    "renderedContentHash", "disclaimerVersion", "providerId", "providerVersion", "actor",
    "note", "createdAt", "hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousHash": { "type": "string", "pattern": "^(GENESIS|[a-f0-9]{64})$" },
    "type": { "const": "synthetic-attachment-prepared" },
    "contractVersion": { "const": "eqpass-perl-attachment/rfi-0.1" },
    "contractStatus": { "const": "proposed-rfi-only" },
    "status": { "const": "prepared-not-attached" },
    "requestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotencyKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessmentId": { "type": "string", "pattern": "^FF-TEST-[A-Z0-9-]+$" },
    "sourceEventReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scoringVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "findingsReportVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "findingsReportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reportArtifactId": { "type": "string", "format": "uuid" },
    "reportArtifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceAssessmentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "renderedReportFormat": { "const": "perl-clinician-report/1.0" },
    "renderedMediaType": { "const": "text/html" },
    "renderedContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disclaimerVersion": { "const": "ff-clinical-disclaimer/draft-2026-08" },
    "providerId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "providerVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "actor": { "type": "string", "minLength": 2, "maxLength": 48 },
    "note": { "type": "string", "minLength": 20, "maxLength": 300 },
    "createdAt": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
